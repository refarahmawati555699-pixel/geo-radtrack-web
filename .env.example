# Salin menjadi .env.local kalau mau mengganti koneksi database.
# Tanpa file ini, aplikasi memakai nilai bawaan di bawah (cocok dengan docker-compose.yml).
DATABASE_URL=postgres://geo:geo123@127.0.0.1:5433/georadtrack

# Password untuk login admin (hanya admin yang bisa mengedit data).
# Di Vercel, isi sebagai Environment Variable ADMIN_PASSWORD.
# Kalau kosong: bisa mengedit hanya saat npm run dev (lokal), di production semua orang hanya bisa melihat.
ADMIN_PASSWORD=
